        <!-- radiusKm (km): Hart's own 500 km analysis-circle radius, used for both thermal winds, parameter B's semicircles, and the mask's own ring_radius_km -->
        <ConstantField value="500.0"/>
        <!-- bThresholdM (m): the Evans and Hart (2003) asymmetric/symmetric line for parameter B (900-600 hPa or its equivalent) -->
        <ConstantField value="10.0"/>
        <!-- layerScale: 1.0, B is on Hart's own 900-600 hPa thickness (GH 600MB minus GH 900MB), no rescaling -->
        <ConstantField value="1.0"/>
        <!-- depthHpa (hPa): the closed-low mask's annulus depth test, see cps_HCPSidx.xml -->
        <ConstantField value="5.0"/>
        <!-- blobKm (km): radius of the blob painted around each detected low's center, see cps_HCPSidx.xml -->
        <ConstantField value="200.0"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
        <!-- pmslKind: 0 = the first Field is mean sea level pressure (Pa or hPa), 1 = it is 1000 hPa height, converted at 8 m per hPa -->

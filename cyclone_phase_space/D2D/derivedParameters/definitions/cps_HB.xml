<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Hart CPS parameter B (thermal asymmetry), gridded: at
  every grid point, Hart's own right-minus-left semicircle difference of
  layer thickness across the direction of the steering flow (the mean of
  the 850/700/500/300 hPa wind, area averaged over 500 km), over the same
  500 km radius HVTL/HVTU use. cps_HartCPS.half_disk_means gives the mean
  thickness over the north, south, east and west half-disks of every
  point, and with the unit motion vector (mx, my) the difference is
  mx*(south - north) + my*(east - west), exact for any wavenumber-one
  thickness pattern about the point (a uniform gradient or a storm-scale
  dipole alike; only odd harmonics of order 3 and up are missed). See
  cps_HartCPS.py's module docstring, "Parameter B and the joint class",
  for the derivation and the steering-flow motion proxy's own limits
  (unreliable or missing for a stationary or steering-opposed storm),
  and D2D/README.md's "Parameter B" section.

  TWO METHODS, tried in order; AWIPS runs the first whose inputs the
  model carries:
    1. cps_HartCPS.executeBLayer on Hart's own 900-600 hPa thickness
       (GH 600MB minus GH 900MB), layerScale 1.0: no rescaling, the
       number reads directly against Hart's 10 m onset threshold. Runs on
       a model that carries 900 and 600 hPa height (the GFS). The two
       heights are blanked below ground at 900 and 600 hPa.
    2. cps_HartCPS.executeB on the 925-700 hPa thickness, rescaled to a
       900-600 hPa equivalent by layerScale = ln(900/600)/ln(925/700) =
       1.4548 so the same 10 m threshold applies, on every other model.
       This is the method this package shipped with, unchanged; the
       standard-level method and the fallback are the same block (the
       two-slope mean of cps_HVTL.xml is a thermal wind construction and
       has no B counterpart).

  Hemisphere: the coriolis pseudo-field's sign is the hemisphere factor h
  (positive Northern Hemisphere, negative Southern) - see cps_HartCPS.
  parameter_b_grid. A 2D coriolis field gets the correct sign on both
  sides of a grid that straddles the equator; a scalar assumes one
  hemisphere everywhere.

  Below-ground masking: both heights are blanked (NaN) before the
  thickness difference wherever they are below ground for their own
  pressure, using the surface pressure field (P, Surface) and capHpa
  below - see cps_HartCPS.mask_below_ground and cps_HVTL.xml's comment for
  the same convention. With the 900 hPa cap, 900 hPa is masked exactly
  where 925 hPa is (surface pressure under 900 hPa).

  VERIFY against an existing definition in
  /awips2/edex/data/utility/common_static/base/derivedParameters/definitions/
  (for example VTL.xml or one of this package's own cps_HVTL.xml/cps_HCPSclass.xml):
    - the geopotential height field's abbreviation is "GH" as used below,
    - fixed-level Field references use the "900MB"/"600MB"/"925MB"/
      "700MB"/"850MB"/"500MB"/"300MB" spelling,
    - the surface pressure field's abbreviation is "P" at level="Surface"
      as used below (confirmed on this site; some builds spell the
      surface plane "0.0SFC" instead),
    - the coriolis pseudo-field is referenced by base vorticity
      definitions on this site under the abbreviation "coriolis" below;
      if this definition fails to load, replace the coriolis Field with
      <ConstantField value="1.0"/> at the same position in both blocks
      to assume the Northern Hemisphere,
    - the "dx"/"dy" pseudo-fields and <ConstantField> are accepted,
    - unit="" (empty) is accepted - confirmed to load on a real AWIPS
      site for this package's other CPS fields, which use the same
      convention.
-->
<DerivedParameter abbreviation="HB" name="Hart CPS B 900-600 equiv (m)" unit="">
    <Method name="cps_HartCPS.executeBLayer" levels="Surface">
        <!-- Method 1: Hart's own 900-600 hPa thickness (GFS); zTop = GH 600MB, zBot = GH 900MB -->
        <Field abbreviation="GH" level="600MB"/>
        <Field abbreviation="GH" level="900MB"/>
        <Field abbreviation="uW" level="850MB"/>
        <Field abbreviation="vW" level="850MB"/>
        <Field abbreviation="uW" level="700MB"/>
        <Field abbreviation="vW" level="700MB"/>
        <Field abbreviation="uW" level="500MB"/>
        <Field abbreviation="vW" level="500MB"/>
        <Field abbreviation="uW" level="300MB"/>
        <Field abbreviation="vW" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="coriolis"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-circle radius -->
        <ConstantField value="500.0"/>
        <!-- pTop (hPa): pressure of zTop (600MB, the first Field) -->
        <ConstantField value="600"/>
        <!-- pBot (hPa): pressure of zBot (900MB, the second Field) -->
        <ConstantField value="900"/>
        <!-- layerScale: 1.0, this is Hart's own 900-600 hPa layer, no rescaling -->
        <ConstantField value="1.0"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
    </Method>
    <Method name="cps_HartCPS.executeB" levels="Surface">
        <!-- Method 2, standard levels and fallback alike: the 925-700 hPa thickness rescaled to a 900-600 hPa equivalent -->
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="uW" level="850MB"/>
        <Field abbreviation="vW" level="850MB"/>
        <Field abbreviation="uW" level="700MB"/>
        <Field abbreviation="vW" level="700MB"/>
        <Field abbreviation="uW" level="500MB"/>
        <Field abbreviation="vW" level="500MB"/>
        <Field abbreviation="uW" level="300MB"/>
        <Field abbreviation="vW" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="coriolis"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-circle radius -->
        <ConstantField value="500.0"/>
        <!-- layerScale: rescales B from the 925-700 hPa layer to a 900-600 hPa equivalent, ln(900/600)/ln(925/700) = 1.45477..., so Hart's 10 m onset threshold applies; pass 1.0 for the raw, unscaled 925-700 hPa value -->
        <ConstantField value="1.4548"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
    </Method>
</DerivedParameter>

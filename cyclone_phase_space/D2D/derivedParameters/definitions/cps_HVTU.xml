<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Hart CPS upper thermal wind, actual method: same window
  max-minus-min / least-squares-slope-against-ln(p) computation as
  cps_HVTL.xml, over the upper band. Units are meters (of dZ) per unit
  of ln(p). Positive = warm core, negative = cold core. See cps_HVTL.xml's
  comment and cps_HartCPS.py's module docstring for the full method
  description.

  TWO METHODS, tried in order; AWIPS runs the first whose inputs the
  model carries:
    1. cps_HartCPS.executeBand7 on Hart's own 600-300 hPa band at 50 hPa
       spacing (600, 550, 500, 450, 400, 350, 300 hPa). Runs on a model
       whose inventory carries every one of the seven levels (the GFS).
    2. cps_HartCPS.executeBand3 on 500/400/300 hPa (cps_HartCPS.UPPER_BAND),
       on every other model. There is no two-slope-mean counterpart for
       the upper band: 500/400/300 already sits inside Hart's 600-300 hPa
       layer and is the closest standard-level estimator of it (rms 20 m,
       bias -5 m across the five synthetic profiles of
       article/figures/band_comparison.py), and every alternative that
       pulls 700 hPa into the upper band is worse (rms 25 to 65 m). The
       standard-level method and the fallback are therefore the same
       block, and HVTL's three-way split has a two-way split here.

  Below-ground masking: same as cps_HVTL.xml, via the surface pressure
  field (P, Surface) and capHpa - see cps_HartCPS.mask_below_ground. In
  practice 600 hPa and above are almost never below ground (only over
  the Himalaya or Antarctica), so this mostly has no effect here, but
  the Field/ConstantField are still required since executeBand7 and
  executeBand3 always expect psfc/capHpa.

  VERIFY: same checks as cps_HVTL.xml (GH abbreviation, fixed-level Field
  spelling including the 50 hPa levels "550MB"/"450MB"/"350MB" in the GFS
  inventory, P abbreviation and its Surface level spelling, dx/dy
  pseudo-fields and ConstantField support, levels= value, unit=""
  acceptance).
-->
<DerivedParameter abbreviation="HVTU" name="Hart CPS -VTU upper band (m)" unit="">
    <Method name="cps_HartCPS.executeBand7" levels="Surface">
        <!-- Method 1: Hart's own 600-300 hPa band, seven levels at 50 hPa spacing (GFS) -->
        <Field abbreviation="GH" level="600MB"/>
        <Field abbreviation="GH" level="550MB"/>
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="450MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="350MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-circle radius -->
        <ConstantField value="500.0"/>
        <!-- p1: pressure (hPa) matching z1 (600MB) above -->
        <ConstantField value="600"/>
        <!-- p2: pressure (hPa) matching z2 (550MB) above -->
        <ConstantField value="550"/>
        <!-- p3: pressure (hPa) matching z3 (500MB) above -->
        <ConstantField value="500"/>
        <!-- p4: pressure (hPa) matching z4 (450MB) above -->
        <ConstantField value="450"/>
        <!-- p5: pressure (hPa) matching z5 (400MB) above -->
        <ConstantField value="400"/>
        <!-- p6: pressure (hPa) matching z6 (350MB) above -->
        <ConstantField value="350"/>
        <!-- p7: pressure (hPa) matching z7 (300MB) above -->
        <ConstantField value="300"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
    </Method>
    <Method name="cps_HartCPS.executeBand3" levels="Surface">
        <!-- Method 2, standard levels and fallback alike: the 500/400/300 hPa band (cps_HartCPS.UPPER_BAND) -->
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-circle radius -->
        <ConstantField value="500.0"/>
        <!-- p1: pressure (hPa) matching z1 (500MB) above -->
        <ConstantField value="500"/>
        <!-- p2: pressure (hPa) matching z2 (400MB) above -->
        <ConstantField value="400"/>
        <!-- p3: pressure (hPa) matching z3 (300MB) above -->
        <ConstantField value="300"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
    </Method>
</DerivedParameter>
